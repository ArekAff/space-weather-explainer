# Line endings: store text as LF in the repository, whatever core.autocrlf says on a machine
* text=auto

# Windows batch files must keep CRLF or cmd.exe can misread them (the NOAA scheduled task runs one)
*.cmd text eol=crlf
*.bat text eol=crlf

# Recorded source responses are compared byte for byte in tests: never convert them
code/ingestion/tests/fixtures/** -text

# Binary documents and data
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.gz binary
*.parquet binary
